{
  "name": "iplayer",
  "version": "0.1.0",
  "private": true,
  "description": "iPlayer - a modern desktop video player built with Rust + Tauri",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "build:mac:universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:win": "tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "build:win:cross": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --runner cargo-xwin",
    "build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/source.png",
    "fetch:sidecar": "node scripts/fetch-sidecar.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {}
}
