{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iPlayer",
  "version": "0.1.0",
  "identifier": "com.iplayer.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "iPlayer",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0e1014",
        "dragDropEnabled": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Entertainment",
    "shortDescription": "A modern desktop video player",
    "longDescription": "iPlayer is a desktop video player built with Rust + Tauri. It plays virtually any format via a bundled ffmpeg sidecar, offers a collapsible playlist sidebar, a fixed control bar, always-on-top, snapshots, audio extraction and GIF export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
